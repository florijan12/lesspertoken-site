{
  // Cloudflare Worker that serves the built site from dist/
  "name": "rapid-dust-d52a",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "lesspertoken.com", "custom_domain": true }
  ],
  "workers_dev": true
}
